---
// A dated article. Used by exactly one route — pages/[year]/[month]/[day]/[slug]
// which renders every file in src/content/posts.
//
// Everything shared with the rest of the site (shell, body copy, flow) comes
// from Page.astro; this layout adds only what a *post* has that a page doesn't:
// the byline, the end mark, older/newer links, and the schema.org Article type.
import Page from './Page.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date | string;
  edit?: Date | string;
  useMath?: boolean;
  readingTime?: number;
  styles?: string[];
  entity?: { type?: string; name?: string; same_as?: string[] };
  schemaType?: string;
  newer?: PostLink;
  older?: PostLink;
}

interface PostLink {
  title: string;
  url: string;
}

const {
  title,
  description,
  image,
  date,
  edit,
  useMath = false,
  readingTime,
  styles,
  entity,
  schemaType,
  newer,
  older,
} = Astro.props;

// timeZone: 'UTC' so a frontmatter date like 2020-02-06 always displays as
// "February 6, 2020" regardless of the build machine's local timezone.
const formatDate = (d: Date | string) =>
  new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Page
  title={title}
  description={description}
  image={image}
  useMath={useMath}
  styles={styles}
  entity={entity}
  schemaType={schemaType}
  layoutKind="post"
  prose
  article
>
  {date && (
    <p class="post__date" slot="meta">
      {formatDate(date)}{readingTime ? '' : '.'}
      {readingTime && (
        <> · <span class="post__reading-time">{readingTime}</span> min read.</>
      )}
      {edit && <> Edited on {formatDate(edit)}.</>}
    </p>
  )}
  <slot />
  <Fragment slot="body-end">
    <div class="post__end" aria-hidden="true"></div>
    {(older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older && (
          <a class="post-nav__link post-nav__link--older" href={older.url}>
            <span class="post-nav__label">older</span>
            <span class="post-nav__title">{older.title}</span>
          </a>
        )}
        {newer && (
          <a class="post-nav__link post-nav__link--newer" href={newer.url}>
            <span class="post-nav__label">newer</span>
            <span class="post-nav__title">{newer.title}</span>
          </a>
        )}
      </nav>
    )}
  </Fragment>
</Page>
