---
import Page from '../../layouts/Page.astro';
import ControlGroup from '../../components/ControlGroup.astro';
import ImageUpload from '../../components/ImageUpload.astro';
import RangeSlider from '../../components/RangeSlider.astro';
---
<Page item="image-tools/color-palette">
  <p>Drop in an image to extract its color palette.</p>
  <p>
    This tool uses K-means clustering to identify the dominant colors in your image.
    All processing occurs locally in your browser.
  </p>

  <div class="palette-container stack" data-mount="color-palette">
    <div class="stack">
      <ImageUpload>
        <div slot="overlay" class="palette-markers" data-ref="markers" aria-hidden="true"></div>
        <div class="palette-output" data-ref="output"></div>
      </ImageUpload>

      <ControlGroup label="colors" for="colors-input">
        <RangeSlider
          id="colors-input"
          value={5}
          min={2}
          max={10}
        />
      </ControlGroup>
    </div>

    <template data-ref="swatch">
      <button class="color-swatch" type="button" data-highlight="off" data-color="" data-index="">
        <span class="color-swatch__hex"></span>
        <span class="color-swatch__feedback" aria-hidden="true">copied</span>
      </button>
    </template>
  </div>
</Page>

<script>
  import { copyText } from '../../lib/clipboard.ts';
  import { extractPalette, isLightColor, type PaletteColor } from '../../lib/color-palette.ts';
  import { mount } from '../../lib/lifecycle.ts';

  // Larger sample than the lightbox dots: a one-shot action can afford it.
  const SAMPLE_SIZE = 128;
  // Past this a hex crowds its swatch.
  const MAX_PER_ROW = 5;
  // RGB distance within which a new color keeps an old color's marker. The
  // palette reclusters on every count change, so survivors shift a little.
  const SAME_MARKER = 24;

  const rgbDistance = (x: PaletteColor, y: PaletteColor) => Math.hypot(x.r - y.r, x.g - y.g, x.b - y.b);

  mount('[data-mount="color-palette"]', ({ ref, find }) => {
    const upload = find('[data-image-upload]');
    const preview = find<HTMLImageElement>('.image-upload__preview');
    const colorsInput = find<HTMLInputElement>('#colors-input');
    const paletteOutput = ref('output');
    const markers = ref('markers');
    const swatchTemplate = ref<HTMLTemplateElement>('swatch');

    function copySwatch(swatch: HTMLElement, hex: string) {
      void copyText(hex).then(() => {
        swatch.classList.add('copied');
        const timer = window.setTimeout(() => swatch.classList.remove('copied'), 900);
        // Replace any pending timer so rapid re-clicks don't end too early.
        const prev = Number(swatch.dataset.copyTimer);
        if (prev) clearTimeout(prev);
        swatch.dataset.copyTimer = String(timer);
      });
    }

    // A swatch and its marker light up together; the other markers dim.
    function setActive(index: string | null) {
      markers.classList.toggle('has-active', index !== null);
      for (const el of [...paletteOutput.children, ...markers.children] as HTMLElement[]) {
        el.classList.toggle('is-active', el.dataset.index === index);
      }
    }

    // Touch draws no hover: a tap fires enter and leave around itself.
    function linkHover(el: HTMLElement) {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'touch') setActive(el.dataset.index!);
      });
      el.addEventListener('pointerleave', () => setActive(null));
    }

    const markerColor = new WeakMap<HTMLElement, PaletteColor>();

    // A color that survives a count change keeps its marker, which glides to
    // its new spot; only new colors pop in and dropped ones pop out.
    function renderMarkers(colors: PaletteColor[]) {
      const old = [...markers.querySelectorAll<HTMLElement>('.palette-marker:not(.is-leaving)')];
      colors.forEach((color, index) => {
        let match = -1;
        let nearest = SAME_MARKER;
        old.forEach((marker, i) => {
          const d = rgbDistance(color, markerColor.get(marker)!);
          if (d < nearest) [match, nearest] = [i, d];
        });
        const marker = match >= 0 ? old.splice(match, 1)[0] : createMarker();
        markerColor.set(marker, color);
        marker.dataset.index = String(index);
        marker.style.setProperty('--x', String(color.x));
        marker.style.setProperty('--y', String(color.y));
        marker.style.setProperty('--swatch', color.hex);
        marker.classList.toggle('palette-marker--light', isLightColor(color.r, color.g, color.b));
      });
      for (const marker of old) {
        delete marker.dataset.index;
        marker.classList.add('is-leaving');
        // No exit animation under reduced motion: remove it now. (A glide in
        // progress is a transition, which never fires animationend.)
        if (!marker.getAnimations().some((a) => a instanceof CSSAnimation)) marker.remove();
        else marker.addEventListener('animationend', () => marker.remove(), { once: true });
      }
    }

    function createMarker() {
      const marker = document.createElement('span');
      marker.className = 'palette-marker';
      linkHover(marker);
      markers.appendChild(marker);
      return marker;
    }

    function displayPalette(colors: PaletteColor[]) {
      paletteOutput.innerHTML = '';
      setActive(null);
      renderMarkers(colors);
      // At most MAX_PER_ROW to a row, rows balanced: 6 is 3 + 3, never 5 + 1.
      const rows = Math.ceil(colors.length / MAX_PER_ROW);
      paletteOutput.style.setProperty('--cols', String(Math.ceil(colors.length / rows)));

      if (colors.length === 0) {
        paletteOutput.innerHTML = '<p>No colors could be extracted from this image.</p>';
        return;
      }

      colors.forEach((color, index) => {
        const { r, g, b, hex } = color;
        const fragment = swatchTemplate.content.cloneNode(true) as DocumentFragment;
        const swatch = fragment.querySelector<HTMLElement>('.color-swatch')!;
        swatch.style.setProperty('--swatch', `rgb(${r}, ${g}, ${b})`);
        swatch.dataset.color = hex;
        swatch.dataset.index = String(index);
        swatch.querySelector('.color-swatch__hex')!.textContent = hex;
        if (isLightColor(r, g, b)) swatch.classList.add('color-swatch--light');
        swatch.addEventListener('click', () => copySwatch(swatch, hex));
        swatch.addEventListener('focus', () => setActive(swatch.dataset.index!));
        swatch.addEventListener('blur', () => setActive(null));
        linkHover(swatch);
        paletteOutput.appendChild(swatch);
      });
    }

    function extract() {
      if (!preview.src) return;
      displayPalette(extractPalette(preview, {
        count: parseInt(colorsInput.value),
        sampleSize: SAMPLE_SIZE,
      }));
    }

    // A new image starts clean: its colors aren't the old markers moving.
    upload.addEventListener('image-upload:change', () => {
      markers.replaceChildren();
      extract();
    });
    // On release, not per step: extraction is too slow on phones to run mid-drag.
    colorsInput.addEventListener('change', extract);
  });
</script>
