---
import Page from '../../layouts/Page.astro';
import CopyButton from '../../components/CopyButton.astro';
import ControlGroup from '../../components/ControlGroup.astro';
import SelectionSwitch from '../../components/SelectionSwitch.astro';
import ImageUpload from '../../components/ImageUpload.astro';
import RangeSlider from '../../components/RangeSlider.astro';

const paletteOptions = [
  { value: 'classic', label: 'Classic' },
  { value: 'blocks', label: 'Blocks' },
  { value: 'minimal', label: 'Minimal' },
];

const ditherOptions = [
  { value: 'none', label: 'Smooth' },
  { value: 'ordered', label: 'Ordered' },
  { value: 'floyd', label: 'Floyd' },
];
---
<Page item="image-tools/ascii">
  <p>Convert an image to ASCII art.</p>

  <div class="ascii-container stack" data-mount="ascii">
    <div class="stack">
      <ImageUpload />

      <ControlGroup label="characters" for="width-input">
        <RangeSlider
          id="width-input"
          value={80}
          min={15}
          max={150}
        />
      </ControlGroup>

      <ControlGroup label="palette">
        <SelectionSwitch
          id="ascii-palette-toggle"
          options={paletteOptions}
          active="classic"
        />
      </ControlGroup>

      <ControlGroup label="dither">
        <SelectionSwitch
          id="ascii-dither-toggle"
          options={ditherOptions}
          active="none"
        />
      </ControlGroup>

      <div class="toolbar">
        <button class="normal-btn" data-ref="convert">Convert to ASCII</button>
        <CopyButton
          id="copy-btn"
          class="normal-btn"
          style="display: none;"
        >Copy Text</CopyButton>
        <button class="normal-btn" style="display: none;" data-ref="download">Download PNG</button>
      </div>
    </div>

    <pre id="ascii-output" data-ref="output"></pre>
  </div>
</Page>

<script>
  import {
    ASCII_PALETTES,
    calculateHeight,
    calculateOptimalFontSize,
    convertToAscii,
    type AsciiPalette,
    type DitherMode,
  } from '../../lib/ascii-utils.ts';
  import { mount } from '../../lib/lifecycle.ts';

  mount('[data-mount="ascii"]', ({ ref, find }) => {
    const upload = find('[data-image-upload]');
    const preview = find<HTMLImageElement>('.image-upload__preview');
    const widthInput = find<HTMLInputElement>('#width-input');
    const convertBtn = ref('convert');
    const asciiOutput = ref('output');
    const copyBtn = find('#copy-btn');
    const downloadBtn = ref('download');

    let palette: AsciiPalette = 'classic';
    let dither: DitherMode = 'none';

    function setActionVisibility(visible: boolean) {
      const display = visible ? 'inline-block' : 'none';
      copyBtn.style.display = display;
      downloadBtn.style.display = display;
    }

    function render(showMissingImageAlert: boolean) {
      if (!preview.src) {
        if (showMissingImageAlert) alert('Please select an image first!');
        return;
      }

      const width = parseInt(widthInput.value);
      const padLeft = parseFloat(getComputedStyle(asciiOutput).paddingLeft);
      const containerWidth = asciiOutput.clientWidth - padLeft * 2;
      const fontSize = calculateOptimalFontSize(containerWidth, width, asciiOutput);

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d')!;
      const height = calculateHeight(width, preview.naturalWidth, preview.naturalHeight);
      canvas.width = width;
      canvas.height = height;
      ctx.drawImage(preview, 0, 0, width, height);
      const imageData = ctx.getImageData(0, 0, width, height);
      const ascii = convertToAscii(imageData, width, height, {
        characters: ASCII_PALETTES[palette],
        dither,
      });

      asciiOutput.style.fontSize = `${fontSize}px`;
      asciiOutput.style.width = '100%';
      asciiOutput.style.maxWidth = '525px';
      asciiOutput.textContent = ascii;
      copyBtn.dataset.copyValue = ascii;
      setActionVisibility(true);
    }

    upload.addEventListener('image-upload:change', () => {
      asciiOutput.textContent = '';
      delete copyBtn.dataset.copyValue;
      setActionVisibility(false);
    });

    convertBtn.addEventListener('click', () => render(true));

    find('#ascii-palette-toggle').addEventListener('selection:change', (e) => {
      palette = e.detail.value as AsciiPalette;
      if (asciiOutput.textContent) render(false);
    });

    find('#ascii-dither-toggle').addEventListener('selection:change', (e) => {
      dither = e.detail.value as DitherMode;
      if (asciiOutput.textContent) render(false);
    });

    downloadBtn.addEventListener('click', () => {
      const text = asciiOutput.textContent;
      if (!text) {
        alert('Please convert an image to ASCII first!');
        return;
      }

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d')!;
      const fontSize = 12;
      const fontFamily = 'Courier New, monospace';
      ctx.font = `${fontSize}px ${fontFamily}`;

      const lines = text.split('\n');
      const maxLineLength = Math.max(...lines.map((line) => line.length));
      const lineHeight = fontSize * 1.2;
      const border = 20;
      canvas.width = maxLineLength * fontSize * 0.6 + border * 2;
      canvas.height = lines.length * lineHeight + border * 2;

      ctx.fillStyle = 'white';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = 'black';
      ctx.lineWidth = 2;
      ctx.strokeRect(1, 1, canvas.width - 2, canvas.height - 2);
      ctx.fillStyle = 'black';
      ctx.font = `${fontSize}px ${fontFamily}`;
      ctx.textBaseline = 'top';
      lines.forEach((line, i) => {
        ctx.fillText(line, border, border + i * lineHeight);
      });

      canvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ascii-art.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    });
  });
</script>
