---
// A static sibling of the gallery-backed archives: charms aren't a remote
// manifest of photos but live components, so they can't ride the [thing] route.
import Page from '../../../layouts/Page.astro';
import Charm from '../../../components/charms/Charm.astro';
import { CHARMS, type CharmType } from '../../../components/charms/charms';

const charmTypes = Object.keys(CHARMS) as CharmType[];

// Easter egg: the count charm here tallies the charms themselves.
const charmCount = charmTypes.length;

// Each charm's offset and tilt are dealt from its own name rather than its
// position in the list, so adding one doesn't reshuffle the rest.
function noise(key: string): number {
  let h = 2166136261;
  for (let i = 0; i < key.length; i++) h = Math.imul(h ^ key.charCodeAt(i), 16777619);
  // FNV on its own leaves the low bits barely mixed, which lands most of the
  // offsets on the same side of zero and quietly rebuilds the grid.
  h ^= h >>> 15;
  h = Math.imul(h, 2246822507);
  h ^= h >>> 13;
  return (h >>> 0) / 4294967296;
}

const spread = (name: string, axis: string, limit: number) =>
  ((noise(`${name}#${axis}`) * 2 - 1) * limit).toFixed(1);

const scatter = (name: string) =>
  `--spot-dx:${spread(name, 'x', 26)};--spot-dy:${spread(name, 'y', 30)};` +
  `--spot-rot:${spread(name, 'r', 16)}deg;`;
---

<Page
  title="Charms"
  description="Every decorative charm on the site, tipped out in a pile."
  image="/assets/images/previews/charms.jpg"
>
  <p>Every decorative charm on the site, tipped out in a pile. Give one a poke.</p>

  <ul class="charm-collection">
    {charmTypes.map((type) => (
      <li class="charm-collection__spot" style={scatter(type)}>
        <Charm
          type={type}
          anchor="top-left"
          value={type === 'count' ? charmCount : undefined}
        />
      </li>
    ))}
  </ul>
</Page>
