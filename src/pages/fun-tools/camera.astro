---
import Page from '../../layouts/Page.astro';
import ControlGroup from '../../components/ControlGroup.astro';
import Icon from '../../components/Icon.astro';
import SelectionSwitch from '../../components/SelectionSwitch.astro';
import RangeSlider from '../../components/RangeSlider.astro';
import { cameraModes } from '../../lib/camera-modes/index.ts';

const modeOptions = cameraModes.map((m) => ({ value: m.id, label: m.label }));
---
<Page item="fun-tools/camera">
  <p>See yourself live as ASCII or circles.</p>

  <div class="camera-tool stack" data-mount="camera" data-state="idle">
    <div class="camera-view">
      <button class="camera-start" type="button" data-ref="start">
        <span data-ref="start-label"><span class="camera-start__verb"></span> to start your camera</span>
      </button>

      <div class="camera-frame" data-ref="frame">
        <video class="camera-video" data-ref="video" playsinline muted></video>
        <canvas class="camera-canvas" data-ref="canvas"></canvas>
      </div>

      <p class="camera-caption">
        <button class="camera-name" type="button" data-ref="name" title="Switch camera" disabled>
          <Icon name="camera-rotate" weight="regular" />
          <span class="camera-name__label" data-ref="name-label">Camera</span>
        </button>
        <span class="caption-actions">
          <button type="button" data-ref="save">save png</button>
          <button type="button" data-ref="fullscreen">fullscreen</button>
          <button type="button" data-ref="stop">stop</button>
        </span>
      </p>
    </div>

    <ControlGroup label="mode">
      <SelectionSwitch
        id="camera-mode-toggle"
        options={modeOptions}
        active={modeOptions[0].value}
      />
    </ControlGroup>

    <ControlGroup label="detail" for="detail-input">
      <RangeSlider
        id="detail-input"
        value={33}
        min={0}
        max={100}
      />
    </ControlGroup>

    {cameraModes.map((mode) => (
      mode.controls?.length ? (
        <div class="camera-mode-controls stack" data-mode={mode.id} hidden={mode.id !== modeOptions[0].value}>
          {mode.controls.map((control) => (
            <ControlGroup label={control.label}>
              <SelectionSwitch
                id={`${mode.id}-${control.id}`}
                class={control.id === 'palette' ? 'ascii-ramps' : undefined}
                options={control.options}
                active={control.default}
              />
            </ControlGroup>
          ))}
        </div>
      ) : null
    ))}
  </div>
</Page>

<script>
  import { createCameraManager } from '../../lib/camera-manager.ts';
  import { cameraModes } from '../../lib/camera-modes/index.ts';
  import type { CameraMode } from '../../lib/camera-modes/types.ts';
  import { downloadCanvas } from '../../lib/download.ts';
  import { attachLens } from '../../lib/lens.ts';
  import { mount } from '../../lib/lifecycle.ts';

  type State = 'idle' | 'starting' | 'live' | 'error';

  // getUserMedia's failures, in words. Anything else gets the generic line.
  const ERRORS: Record<string, string> = {
    NotAllowedError: 'Camera access is blocked. Allow it in your browser’s site settings, then try again.',
    NotFoundError: 'No camera found. Connect one, then try again.',
    NotReadableError: 'Another app is using the camera. Close it, then try again.',
  };

  mount('[data-mount="camera"]', ({ root, ref, find, signal }) => {
    const startBtn = ref<HTMLButtonElement>('start');
    const startLabel = ref('start-label');
    const frame = ref('frame');
    const video = ref<HTMLVideoElement>('video');
    const canvas = ref<HTMLCanvasElement>('canvas');
    const nameBtn = ref<HTMLButtonElement>('name');
    const nameLabel = ref('name-label');
    const fullscreenBtn = ref<HTMLButtonElement>('fullscreen');
    const detailInput = find<HTMLInputElement>('#detail-input');

    const ctx = canvas.getContext('2d')!;
    const idleLabel = startLabel.innerHTML;
    let activeMode: CameraMode = cameraModes[0];
    let size = { w: 0, h: 0 };
    let mirror = true;
    let devices: MediaDeviceInfo[] = [];

    // Element fullscreen is missing on iPhone Safari: no promise of it there.
    fullscreenBtn.hidden = !document.fullscreenEnabled;

    // Per-mode sub-option state, seeded from each mode's declared defaults.
    const optionState: Record<string, Record<string, string>> = {};
    for (const mode of cameraModes) {
      optionState[mode.id] = {};
      for (const control of mode.controls ?? []) {
        optionState[mode.id][control.id] = control.default;
        find(`#${mode.id}-${control.id}`).addEventListener('selection:change', (e) => {
          optionState[mode.id][control.id] = e.detail.value;
        });
      }
    }

    find('#camera-mode-toggle').addEventListener('selection:change', (e) => {
      activeMode = cameraModes.find((m) => m.id === e.detail.value) ?? activeMode;
      root.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => {
        el.hidden = el.dataset.mode !== activeMode.id;
      });
    });

    function setState(state: State, message?: string) {
      root.dataset.state = state;
      startBtn.disabled = state === 'starting';
      if (state === 'starting') startLabel.textContent = 'Starting your camera…';
      else if (message) startLabel.textContent = message;
      else startLabel.innerHTML = idleLabel;
    }

    // The backing store follows the frame at device resolution, so glyphs stay
    // crisp; modes draw in CSS pixels through the scaled context.
    function applyCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      size = { w: canvas.clientWidth, h: canvas.clientHeight };
      canvas.width = Math.round(size.w * dpr);
      canvas.height = Math.round(size.h * dpr);
    }

    function renderFrame(v: HTMLVideoElement) {
      if (!size.w || !size.h) return;
      const dpr = window.devicePixelRatio || 1;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, size.w, size.h);
      activeMode.render({
        ctx,
        video: v,
        width: size.w,
        height: size.h,
        detail: parseInt(detailInput.value),
        mirror,
        options: optionState[activeMode.id] ?? {},
      });
    }

    // Set before the track's first frame renders, so a switch never draws a
    // frame or two with the last camera's mirroring.
    function onTrack(track: MediaStreamTrack) {
      // Selfie cameras mirror; a rear camera (environment) shows the world as is.
      mirror = track.getSettings().facingMode !== 'environment';
      video.classList.toggle('is-mirrored', mirror);
      nameLabel.textContent = track.label || 'Camera';
    }

    const camera = createCameraManager({ video, render: renderFrame, onTrack });

    // The frame takes the feed's own shape, so nothing is cropped or stretched
    // outside fullscreen.
    const matchFeed = () => {
      if (video.videoWidth) frame.style.setProperty('--feed-aspect', `${video.videoWidth} / ${video.videoHeight}`);
    };
    video.addEventListener('loadedmetadata', matchFeed);
    video.addEventListener('resize', matchFeed);

    const failure = (err: unknown) => ERRORS[(err as DOMException).name] ?? 'Couldn’t start the camera. Try again?';

    // Labels only exist once access is granted. One camera: nothing to switch.
    async function listCameras() {
      try {
        devices = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === 'videoinput');
      } catch {
        devices = [];
      }
      nameBtn.disabled = devices.length < 2;
    }

    async function start() {
      setState('starting');
      try {
        // False: stopped (or the page left) before access came back.
        if (!(await camera.start())) return;
      } catch (err) {
        console.error('Error accessing camera:', err);
        setState('error', failure(err));
        return;
      }
      setState('live');
      await listCameras();
    }

    // Switching stays live: the canvas holds its last frame until the new feed
    // lands. A camera that won't open hands back to the one that did.
    async function switchCamera() {
      const current = camera.track()?.getSettings().deviceId;
      const at = devices.findIndex((d) => d.deviceId === current);
      const next = devices[(at + 1) % devices.length];
      if (!next) return;
      nameBtn.disabled = true;
      try {
        await camera.start(next.deviceId);
      } catch (err) {
        console.error('Error switching camera:', err);
        try {
          await camera.start(current);
        } catch (again) {
          setState('error', failure(again));
        }
      } finally {
        nameBtn.disabled = devices.length < 2;
      }
    }

    startBtn.addEventListener('click', () => void start());
    nameBtn.addEventListener('click', () => void switchCamera());

    ref('stop').addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      camera.stop();
      setState('idle');
    });

    ref('save').addEventListener('click', () => {
      const ground = getComputedStyle(document.documentElement).getPropertyValue('--background-main').trim();
      downloadCanvas(canvas, `camera-${activeMode.id}.png`, ground || '#fff');
    });

    fullscreenBtn.addEventListener('click', () => {
      frame.requestFullscreen().catch((err) => console.error('Error entering fullscreen:', err));
    });

    attachLens(canvas, signal);

    const resize = new ResizeObserver(applyCanvasSize);
    resize.observe(canvas);
    return () => resize.disconnect();
  });
</script>
