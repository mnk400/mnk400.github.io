---
import Page from '../../layouts/Page.astro';
import ControlGroup from '../../components/ControlGroup.astro';
import SelectionSwitch from '../../components/SelectionSwitch.astro';
import RangeSlider from '../../components/RangeSlider.astro';
import { cameraModes } from '../../lib/camera-modes/index.ts';

const modeOptions = cameraModes.map((m) => ({ value: m.id, label: m.label }));
---
<Page item="fun-tools/camera">
  <p>See yourself live as ASCII or circles.</p>

  <div class="ascii-container stack" data-mount="camera">
    <video style="display: none;" data-ref="video"></video>

    <div class="stack">
      <ControlGroup label="detail" for="detail-input">
        <RangeSlider
          id="detail-input"
          value={33}
          min={0}
          max={100}
        />
      </ControlGroup>

      <ControlGroup label="mode">
        <SelectionSwitch
          id="camera-mode-toggle"
          options={modeOptions}
          active={modeOptions[0].value}
        />
      </ControlGroup>

      {cameraModes.map((mode) => (
        mode.controls?.length ? (
          <div class="mode-controls" data-mode={mode.id} hidden={mode.id !== modeOptions[0].value}>
            {mode.controls.map((control) => (
              <ControlGroup label={control.label}>
                <SelectionSwitch
                  id={`${mode.id}-${control.id}`}
                  options={control.options}
                  active={control.default}
                />
              </ControlGroup>
            ))}
          </div>
        ) : null
      ))}

      <div class="toolbar">
        <button class="normal-btn" data-ref="start">Start Camera</button>
        <button id="fullscreen-btn" class="normal-btn" data-ref="fullscreen">Fullscreen</button>
      </div>
    </div>

    <div class="canvas-container">
      <canvas id="camera-canvas" data-ref="canvas"></canvas>
    </div>
  </div>
</Page>

<script>
  import { createCameraManager } from '../../lib/camera-manager.ts';
  import { cameraModes } from '../../lib/camera-modes/index.ts';
  import type { CameraMode } from '../../lib/camera-modes/types.ts';
  import { mount } from '../../lib/lifecycle.ts';

  mount('[data-mount="camera"]', ({ root, ref, find, signal }) => {
    const video = ref<HTMLVideoElement>('video');
    const canvas = ref<HTMLCanvasElement>('canvas');
    const detailInput = find<HTMLInputElement>('#detail-input');
    const startBtn = ref<HTMLButtonElement>('start');
    const fullscreenBtn = ref<HTMLButtonElement>('fullscreen');

    const ctx = canvas.getContext('2d')!;
    let activeMode: CameraMode = cameraModes[0];

    // Per-mode sub-option state, seeded from each mode's declared defaults.
    // The server pre-renders one SelectionSwitch per control; we just track
    // its value and hand the active mode's slice to render() each frame.
    const optionState: Record<string, Record<string, string>> = {};
    for (const mode of cameraModes) {
      optionState[mode.id] = {};
      for (const control of mode.controls ?? []) {
        optionState[mode.id][control.id] = control.default;
        find(`#${mode.id}-${control.id}`).addEventListener('selection:change', (e) => {
          optionState[mode.id][control.id] = e.detail.value;
        });
      }
    }

    function showModeControls(id: string) {
      root.querySelectorAll<HTMLElement>('.mode-controls').forEach((el) => {
        el.hidden = el.dataset.mode !== id;
      });
    }

    function cssSize() {
      if (camera.isFullscreen()) return { w: window.innerWidth, h: window.innerHeight };
      const w = canvas.parentElement!.clientWidth;
      return { w, h: Math.round((w * 3) / 4) }; // 4:3 to match the feed
    }

    // Size the backing store for the device pixel ratio so canvas text stays
    // crisp, then scale the context so modes can draw in CSS pixels.
    function applyCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      const { w, h } = cssSize();
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function renderFrame(v: HTMLVideoElement) {
      const dpr = window.devicePixelRatio || 1;
      const { w, h } = cssSize();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      activeMode.render({
        ctx,
        video: v,
        width: w,
        height: h,
        detail: parseInt(detailInput.value),
        fullscreen: camera.isFullscreen(),
        options: optionState[activeMode.id] ?? {},
      });
    }

    find('#camera-mode-toggle').addEventListener('selection:change', (e) => {
      const id = e.detail.value;
      activeMode = cameraModes.find((m) => m.id === id) ?? activeMode;
      showModeControls(activeMode.id);
      if (!camera.isRunning()) {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    });

    const camera = createCameraManager({
      video,
      startBtn,
      fullscreenBtn,
      fullscreenTarget: canvas,
      render: renderFrame,
      onStart() {
        applyCanvasSize();
      },
      onStop() {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      },
      onEnterFullscreen() {
        canvas.classList.add('is-fullscreen');
        applyCanvasSize();
      },
      onExitFullscreen() {
        canvas.classList.remove('is-fullscreen');
        applyCanvasSize();
        detailInput.value = '33';
        detailInput.dispatchEvent(new Event('input'));
      },
    });

    window.addEventListener('resize', applyCanvasSize, { signal });
  });
</script>
