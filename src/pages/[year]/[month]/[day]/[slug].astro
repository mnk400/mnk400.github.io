---
import { getCollection, render } from 'astro:content';
import Post from '../../../../layouts/Post.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts'))
    .map((post) => {
      const match = post.id.match(/^(\d{4})-(\d{2})-(\d{2})-(.+)$/);
      if (!match) throw new Error(`Post id doesn't match YYYY-MM-DD-slug: ${post.id}`);
      const [, year, month, day, slug] = match;
      return { post, params: { year, month, day, slug }, url: `/${year}/${month}/${day}/${slug}` };
    })
    // Newest first, same order as the home archive. Ids lead with the date.
    .sort((a, b) => b.post.id.localeCompare(a.post.id));

  const link = (entry?: (typeof posts)[number]) =>
    entry && { title: entry.post.data.title, url: entry.url };

  return posts.map(({ post, params }, index) => ({
    params,
    props: { post, newer: link(posts[index - 1]), older: link(posts[index + 1]) },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// Date from frontmatter, or derived from filename if absent (Jekyll parity).
const date =
  post.data.date ??
  new Date(`${Astro.params.year}-${Astro.params.month}-${Astro.params.day}T00:00:00Z`);

const WORDS_PER_MINUTE = 180;
const readingTime =
  post.data.readingTime ??
  Math.max(
    1,
    Math.round(
      post.body!
        // Strip HTML blocks and markdown syntax so markup isn't counted as words.
        .replace(/<[^>]+>/g, ' ')
        .replace(/[#*_`>\[\]()]/g, ' ')
        .split(/\s+/)
        .filter(Boolean).length / WORDS_PER_MINUTE,
    ),
  );
---
<Post
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  date={date}
  edit={post.data.edit}
  useMath={post.data.useMath}
  readingTime={readingTime}
  newer={newer}
  older={older}
>
  <Content />
</Post>

<!-- Per-post JS modules. Conditional <script> blocks would still get hoisted
     by Astro on every post page; a single wrapper with dynamic import() lets
     Vite code-split each module into its own chunk that only loads on the
     matching post. -->
<script>
  document.addEventListener('astro:page-load', () => {
    const path = location.pathname;
    if (path.includes('/math-art')) {
      import('../../../../lib/posts/math-art.ts').then((m) => m.init());
    } else if (path.includes('/listening-history')) {
      import('../../../../lib/posts/listening-history.ts').then((m) => m.init());
    }
  });
</script>
