---
import { getCollection } from 'astro:content';
import Default from '../layouts/Default.astro';
import ExpandableSection from '../components/ExpandableSection.astro';
import Charm from '../components/charms/Charm.astro';
import MusicWidget from '../components/MusicWidget.astro';
import Footer from '../components/Footer.astro';

// Take only the month and year parts: the separator between them is CLDR
// data that varies by Node version (newer ICU emits "Aug ’26").
const monthYearFormat = new Intl.DateTimeFormat('en-US', { month: 'short', year: '2-digit', timeZone: 'UTC' });
const formatMonthYear = (date: Date) => {
  const parts = monthYearFormat.formatToParts(date);
  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((p) => p.type === type)?.value;
  return `${part('month')}-${part('year')}`;
};

const allPosts = await getCollection('posts');
const posts = allPosts
  .map((post) => {
    const match = post.id.match(/^(\d{4})-(\d{2})-(\d{2})-(.+)$/)!;
    const [, y, m, d, slug] = match;
    const date = post.data.date ?? new Date(`${y}-${m}-${d}T00:00:00Z`);
    return {
      title: post.data.title,
      url: `/${y}/${m}/${d}/${slug}`,
      date,
      monthYear: formatMonthYear(date),
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---
<Default description="Manik's personal website and blog">
  <div class="home stack stack--md">
    <div class="home__intro stack stack--sm">
      <p>
        <!-- Encoded breakable spaces survive Cloudflare's removal of whitespace-only text nodes. -->
        Hi! I am&#32;<b
          ><button
            type="button"
            class="site-title-link"
            data-photo-reveal="/assets/images/site/me.jpg">Manik</button
          >,</b
        >&#32;a software developer who lives in Seattle, these days I help build
        software for&#32;<b
          ><button
            type="button"
            class="site-title-link"
            data-photo-reveal="/assets/images/site/kindle.png">Kindle</button
          ></b
        >&#32;apps and devices. I graduated from&#32;<b
          ><button
            type="button"
            class="site-title-link"
            data-photo-reveal="/assets/images/site/paws.jpg"
            >Northeastern University</button
          ></b
        >&#32;in Boston.
      </p>
      <p>
        I'm also an amateur photographer who spends a lot of my free time
        exploring photography.
      </p>
    </div>

    <ExpandableSection id="blog-archive" class="expandable-section--compact" title="<b>Archive</b>">
      <Charm type="count" value={posts.length} slot="badge" anchor="top-right" x="0.5em" y="-0.8em" rotate={8} size={0.375} />
      <div class="archive">
        <ul>
          {posts.map(post => (
            <li>
              <a class="archive__row" href={post.url}>
                {/* No whitespace between: the date stays glued to the last word. */}
                <span>{post.title}</span><span class="date">{post.monthYear}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </ExpandableSection>

    <div class="music-widget-section">
      <MusicWidget />
    </div>
    <Footer />
  </div>
</Default>
