---
import ThemeSwitcher from './ThemeSwitcher.astro';
import FontSwitcher from './FontSwitcher.astro';
---
<div class="settings-panel" id="settingsPanel" data-settings-panel inert>
  <div class="settings-panel-inner stack stack--sm">
    <ThemeSwitcher />
    <FontSwitcher />
  </div>
</div>

<script>
  function initSettingsPanel() {
    const panel = document.querySelector<HTMLElement>('[data-settings-panel]');
    if (!panel) return;
    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-settings-trigger]');

    // Element-scoped listeners leave with the page during client navigation.
    triggers.forEach(trigger => trigger.addEventListener('click', () => {
      const isOpen = panel.classList.toggle('revealed');
      panel.inert = !isOpen;
      triggers.forEach(button => {
        button.setAttribute('aria-expanded', String(isOpen));
        const label = button.querySelector('.settings-toggle-text');
        if (label) label.textContent = isOpen ? 'close' : 'settings';
      });
    }));
  }

  document.addEventListener('astro:page-load', initSettingsPanel);
</script>
