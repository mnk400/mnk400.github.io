---
interface Props {
  id?: string;
  label?: string;
  accept?: string;
  class?: string;
}

const {
  id = 'image-upload',
  label = 'Select Image',
  accept = 'image/*',
  class: extraClass,
} = Astro.props;

const wrapperClass = ['image-upload', extraClass].filter(Boolean).join(' ');
---
<div id={id} class={wrapperClass} data-image-upload>
  <button class="image-upload__selector" type="button">
    <span>{label}</span>
  </button>
  <input class="image-upload__input" type="file" accept={accept} />
  <img class="image-upload__preview" alt="" />
</div>

<script>
  import { emit } from '../lib/events.ts';
  import { mount } from '../lib/lifecycle.ts';

  mount('[data-image-upload]', ({ root, find }) => {
    const selector = find<HTMLButtonElement>('.image-upload__selector');
    const input = find<HTMLInputElement>('.image-upload__input');
    const preview = find<HTMLImageElement>('.image-upload__preview');

    selector.addEventListener('click', () => input.click());
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = reader.result as string;
        preview.src = dataUrl;
        preview.alt = file.name;
        root.classList.add('image-upload--has-preview');
        emit(root, 'image-upload:change', { file, dataUrl, image: preview });
      };
      reader.readAsDataURL(file);
    });
  });
</script>
