---
import Icon from './Icon.astro';

interface Props {
  id?: string;
  label?: string;
  placeholder?: string;
  class?: string;
}

const {
  id = 'search-pill',
  label = 'Search',
  placeholder = 'search',
  class: extraClass,
} = Astro.props;
---
<div
  class:list={['search-pill', extraClass]}
  id={id}
  data-search-component
>
  <button
    class="search-pill__trigger"
    type="button"
    aria-expanded="false"
    aria-controls={`${id}-field`}
  >
    <Icon name="magnifying-glass" />
    <span>{label}</span>
  </button>
  <label class="search-pill__field" for={`${id}-field`} data-highlight>
    <Icon name="magnifying-glass" />
    <input
      id={`${id}-field`}
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      aria-label={label}
    />
    <button class="search-pill__clear" type="button" aria-label="Clear search" hidden>
      <Icon name="x" />
    </button>
  </label>
</div>

<script>
  import { emit } from '../lib/events.ts';
  import { mount } from '../lib/lifecycle.ts';

  mount('[data-search-component]', ({ root, find }) => {
    const trigger = find<HTMLButtonElement>('.search-pill__trigger');
    const input = find<HTMLInputElement>('.search-pill__field input');
    const clear = find<HTMLButtonElement>('.search-pill__clear');

    const getQuery = () => input.value.trim().toLowerCase();

    function changed() {
      const query = getQuery();
      root.classList.toggle('has-query', query.length > 0);
      clear.hidden = query.length === 0;
      emit(root, 'search:change', { query });
    }

    function setOpen(open: boolean, focusInput: boolean) {
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      if (open && focusInput) input.focus();
    }

    function clearQuery() {
      input.value = '';
      changed();
    }

    trigger.addEventListener('click', () => setOpen(true, true));
    input.addEventListener('input', changed);
    input.addEventListener('focus', () => setOpen(true, false));
    input.addEventListener('blur', () => {
      if (!getQuery()) setOpen(false, false);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (getQuery()) clearQuery();
      setOpen(false, false);
    });
    clear.addEventListener('click', () => {
      clearQuery();
      setOpen(true, true);
    });
  });
</script>
