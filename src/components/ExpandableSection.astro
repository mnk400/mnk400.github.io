---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  expanded?: boolean;
  class?: string;
}

const { id, title, expanded = false, class: extraClass } = Astro.props;
const wrapperClass = ['expandable-section', extraClass].filter(Boolean).join(' ');
---
<div class={wrapperClass} id={id} data-expandable-section>
  <slot name="badge" />
  <button class="expandable-toggle" aria-expanded={expanded ? 'true' : 'false'}>
    <span class="toggle-text" set:html={title} />
    <span class="toggle-icon"><Icon name="plus" /></span>
  </button>
  <div class:list={['expandable-content', { collapsed: !expanded }]}>
    <slot />
  </div>
</div>

<script>
  import { mount } from '../lib/lifecycle.ts';

  // Click toggles aria-expanded and animates max-height between collapsed and
  // the content's measured height, then releases it so the content can reflow.
  mount('[data-expandable-section]', ({ find }) => {
    const button = find<HTMLButtonElement>('.expandable-toggle');
    const content = find('.expandable-content');
    content.classList.toggle('collapsed', button.getAttribute('aria-expanded') !== 'true');

    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));

      if (isExpanded) {
        content.style.maxHeight = content.scrollHeight + 'px';
        // Force reflow so the next class change animates from the current height.
        void content.offsetHeight;
        content.classList.add('collapsed');
        return;
      }

      content.classList.remove('collapsed');
      content.style.maxHeight = content.scrollHeight + 'px';
      const release = (event: TransitionEvent) => {
        if (event.propertyName !== 'max-height' || content.classList.contains('collapsed')) return;
        content.style.maxHeight = '';
        content.removeEventListener('transitionend', release);
      };
      content.addEventListener('transitionend', release);
    });
  });
</script>
