---
import Icon from './Icon.astro';
import type { MoreItem } from '../lib/more.ts';

interface Props {
  items: MoreItem[];
  idPrefix: string;
  emptyText?: string;
  useShortTitle?: boolean;
}

const {
  items,
  idPrefix,
  emptyText = 'No archives are live yet.',
  useShortTitle = false,
} = Astro.props;
---
{items.length > 0 ? (
  <div class="archive-index-grid">
    {items.map((item, index) => {
      const titleId = `${idPrefix}-title-${index + 1}`;
      const title = useShortTitle ? item.shortTitle ?? item.title : item.title;

      return (
        <a class="archive-index-card" href={item.url} aria-labelledby={titleId}>
          <span class="archive-index-card__plate">
            {item.image && (
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            )}
            {/* The count rides the plate so the caption below is only identity. */}
            {item.works && (
              <span class="archive-index-card__count">{item.works} works</span>
            )}
          </span>
          <span class="archive-index-card__caption">
            <span class="archive-index-card__heading">
              <span class="archive-index-card__title" id={titleId}>{title}</span>
              <span class="archive-index-card__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" />
              </span>
            </span>
            {item.years && (
              <span class="archive-index-card__sub">active {item.years}</span>
            )}
            {item.description && (
              <span class="archive-index-card__body">{item.description}</span>
            )}
          </span>
        </a>
      );
    })}
  </div>
) : (
  <p>{emptyText}</p>
)}
