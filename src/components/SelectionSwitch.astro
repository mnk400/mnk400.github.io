---
import { switchClasses, swatchAttributes, type SwitchOption, type SwitchVariant } from '../lib/selection-options.ts';

interface Props {
  id: string;
  options: SwitchOption[];
  active?: string;
  class?: string;
  variant?: SwitchVariant;
}

const { id, options, active, class: extraClass, variant } = Astro.props;
const activeValue = active ?? options[0]?.value;

const classes = switchClasses(variant, extraClass);
---
<div class={classes} id={id} data-selection-switch>
  {options.map(opt => (
    <span
      id={opt.value}
      class:list={['switch-option', { active: opt.value === activeValue }]}
      data-value={opt.value}
      {...swatchAttributes(opt.swatch)}
    >{opt.label}</span>
  ))}
</div>

<script>
  import { initSelectionControls } from '../lib/selection-controls.ts';

  document.addEventListener('astro:page-load', () => initSelectionControls());
</script>
