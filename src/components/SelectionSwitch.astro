---
import { switchClasses, type SelectionOption } from '../lib/selection-options.ts';

interface Props {
  id: string;
  options: SelectionOption[];
  active?: string;
  class?: string;
}

const { id, options, active, class: extraClass } = Astro.props;
const activeValue = active ?? options[0]?.value;

const classes = switchClasses(extraClass);
---
<div class={classes} id={id} data-selection-switch>
  {options.map(opt => (
    <button
      type="button"
      id={opt.value}
      class="switch-option"
      aria-pressed={opt.value === activeValue ? 'true' : 'false'}
      data-value={opt.value}
    >{opt.label}</button>
  ))}
</div>

<script>
  import { initSelectionControls } from '../lib/selection-controls.ts';

  document.addEventListener('astro:page-load', () => initSelectionControls());
</script>
