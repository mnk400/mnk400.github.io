---
// Charm, a small decorative element pinned to a corner of a positioned host.
//
// The host must be `position: relative`. The charm absolutely positions itself
// to one of the host's corners, then applies an outward nudge (`x`/`y`) and a
// resting `rotate`. All instance values ride in as CSS custom properties so no
// per-instance numbers leak into SCSS.
//
// Pass `type` to render a registered charm's body from the registry (see
// charms.ts) — the charm-specific look lives in a `.charm--<type>` partial
// under `styles/partials/charms/`. Text charms (e.g. `count`) take their
// content via `value`. As an escape hatch for one-offs, omit `type` and pass
// your own markup as children plus a `class` modifier.

import { CHARMS, type CharmDef, type CharmType } from './charms';

interface Props {
  type?: CharmType;
  anchor?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  x?: string; // outward horizontal nudge, e.g. '0.3em'
  y?: string; // outward vertical nudge, e.g. '-0.55em'
  rotate?: number; // resting tilt in degrees
  size?: number; // size multiplier over the charm's natural size (1 = default)
  value?: string | number; // content for text charms (e.g. count)
  class?: string; // charm modifier when not using `type` (e.g. 'charm--flower')
}

const {
  type,
  anchor = 'top-right',
  x = '0',
  y = '0',
  rotate = 0,
  size,
  value,
  class: className = '',
} = Astro.props;

const anchorClass = {
  'top-right': 'charm--tr',
  'top-left': 'charm--tl',
  'bottom-right': 'charm--br',
  'bottom-left': 'charm--bl',
}[anchor];

// Widened to CharmDef on purpose: CHARMS uses `satisfies`, so each entry keeps
// its literal type and only `flower` carries decoding/fetchpriority. Reading
// those off the raw union fails on the entries that omit them.
const def: CharmDef | null = type ? CHARMS[type] : null;
const typeClass = type ? `charm--${type}` : className;

const effectiveSize = size ?? def?.size;

const style =
  `--charm-x:${x};--charm-y:${y};--charm-rotate:${rotate}deg;` +
  (effectiveSize !== undefined ? `--charm-size:${effectiveSize};` : '');
---

<span class:list={['charm', anchorClass, typeClass]} style={style} aria-hidden="true">
  {def ? (
    <span class="charm-fx">
      {def.kind === 'image' && (
        <img
          class="charm-fx__body"
          src={def.src}
          alt=""
          decoding={def.decoding ?? 'async'}
          fetchpriority={def.fetchpriority}
        />
      )}
      {def.kind === 'svg' && <span class="charm-fx__body" set:html={def.markup} />}
      {def.kind === 'text' && <span class="charm-fx__body">{value ?? def.sample}</span>}
    </span>
  ) : (
    <slot />
  )}
</span>

<script>
  // Opt-in click pulse for charms using the `.charm-fx__body` contract (see
  // styles/partials/charms/_motion). Bundled once for the whole site; wires
  // every such charm on the page and re-runs after view transitions.
  function wireCharmPulse() {
    document.querySelectorAll<HTMLElement>('.charm-fx__body').forEach((body) => {
      const charm = body.closest<HTMLElement>('.charm');
      if (!charm || charm.dataset.pulseInit === 'true') return;
      charm.dataset.pulseInit = 'true';

      charm.addEventListener('click', () => {
        body.classList.remove('is-pulsing');
        void body.offsetWidth; // reflow so the animation retriggers on rapid clicks
        body.classList.add('is-pulsing');
      });
      body.addEventListener('animationend', (e) => {
        if (e.animationName === 'charm-pulse') body.classList.remove('is-pulsing');
      });
    });
  }

  // The clock charm's hands are CSS animations with the real periods, so the
  // only work here is seeking each to `now` with a negative animation-delay —
  // after that the browser keeps time and nothing runs per frame.
  function wireCharmClocks() {
    const now = new Date();
    const seconds = now.getSeconds() + now.getMilliseconds() / 1000;
    const minutes = now.getMinutes() + seconds / 60;
    const hours = (now.getHours() % 12) + minutes / 60;

    // Seconds elapsed into each hand's own cycle.
    const elapsed: Record<string, number> = {
      second: seconds,
      minute: minutes * 60,
      hour: hours * 3600,
    };

    document.querySelectorAll<HTMLElement>('.charm--clock .clock-hand').forEach((hand) => {
      const unit = hand.dataset.hand;
      if (unit && unit in elapsed) hand.style.animationDelay = `-${elapsed[unit]}s`;
    });
  }

  document.addEventListener('astro:page-load', () => {
    wireCharmPulse();
    wireCharmClocks();
  });
</script>
