---
import SelectionSwitch from './SelectionSwitch.astro';
import { themes, defaultTheme } from '../lib/theme.ts';

const options = themes.map(t => ({ value: t.name, label: t.label, swatch: { theme: t.name } }));
const SWITCH_ID = 'themeSwitch';
---
<SelectionSwitch id={SWITCH_ID} options={options} active={defaultTheme} variant="swatch" />

<script>
  import { setTheme, getActiveTheme } from '../lib/theme.ts';
  import { setSwitchValue as syncActive } from '../lib/selection-controls.ts';

  function wire() {
    const sw = document.getElementById('themeSwitch');
    if (!sw) return;
    syncActive(sw, getActiveTheme());
    if (sw.dataset.themeWired === 'true') return;
    sw.dataset.themeWired = 'true';
    sw.addEventListener('change', (e: Event) => {
      const value = (e as CustomEvent<{ value: string }>).detail?.value;
      if (value) {
        setTheme(value);
        syncActive(sw, value);
      }
    });
  }

  document.addEventListener('astro:page-load', wire);
</script>
